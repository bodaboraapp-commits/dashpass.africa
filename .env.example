# -----------------------------------------------------------------------------
# MtaaPass environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Generate a fresh application key with:  php scripts/keygen.php
# -----------------------------------------------------------------------------

APP_NAME="MtaaPass"
# Compact name used on the PWA home-screen icon (defaults to APP_NAME).
# Production deployment for dashpass.africa uses DashPASS.
APP_SHORT_NAME="MtaaPass"
# Support contact shown in the app (account/help screens).
APP_SUPPORT_EMAIL=support@mtaapass.com
# local | testing | staging | production
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Nairobi
APP_VERSION=0.2.1-dashpass

# Show clearly labelled demo rows on screens whose data module is not built yet
# (Resident PWA Visitors and Bookings). MUST be false for production pilots so
# operators never see demo content presented as real visit data.
UI_PREVIEW_CONTENT=true

# 32 random bytes, base64 encoded, prefixed with `base64:`.
# Used to derive HMAC keys for OTP hashing and other keyed digests.
APP_KEY=

# -----------------------------------------------------------------------------
# Database (MySQL 8 / MariaDB 10.4+)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# XAMPP MariaDB listens on 3307 by default; production MySQL uses 3306.
DB_PORT=3307
DB_DATABASE=mtaapass
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
# Test database is dropped and rebuilt by the test runner. Must be a *_test name.
DB_TEST_DATABASE=mtaapass_test

# -----------------------------------------------------------------------------
# Sessions and cookies
# -----------------------------------------------------------------------------
SESSION_NAME=mtaapass_session
# Idle timeout in minutes.
SESSION_LIFETIME=120
# Absolute session lifetime in minutes.
SESSION_ABSOLUTE_LIFETIME=720
# auto => Secure flag enabled automatically when the request is HTTPS.
SESSION_SECURE_COOKIE=auto
SESSION_SAME_SITE=Lax

# -----------------------------------------------------------------------------
# SMS provider
# -----------------------------------------------------------------------------
# log  => development adapter, writes messages to storage/logs/sms.log
# mock => in-memory adapter used by automated tests
# Production must configure a real provider adapter before go-live.
SMS_DRIVER=log
SMS_SENDER_ID=MTAAPASS
# Only honoured outside production. Exposes the development OTP to the client
# and renders it in a clearly labelled development panel.
SMS_DEV_EXPOSE_OTP=true

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
AUTH_OTP_LENGTH=6
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
# Requests allowed per phone number / per IP address inside the window.
AUTH_OTP_PHONE_LIMIT=5
AUTH_OTP_PHONE_WINDOW_SECONDS=900
AUTH_OTP_IP_LIMIT=20
AUTH_OTP_IP_WINDOW_SECONDS=900
AUTH_VERIFY_PHONE_LIMIT=10
AUTH_VERIFY_PHONE_WINDOW_SECONDS=900

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Send HSTS only when the app is served over HTTPS.
SECURITY_HSTS=false
# Correlation IDs are taken from X-Correlation-ID when it is a valid UUID.
SECURITY_TRUST_CORRELATION_HEADER=true

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_MAX_DAYS=14

# Deployment database-sync endpoint token (24+ chars). Leave empty to disable
# /deploy-sync.php entirely; set a long random value on the server only.
DEPLOY_SYNC_TOKEN=

# Email alerts (Resend). Leave MAIL_DRIVER=log locally; set resend + a verified
# sender domain/key in production. NEVER commit a real RESEND_API_KEY.
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME=MtaaPass
MAIL_ALERT_TO=
MAIL_REPLY_TO=
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com
MAIL_TIMEOUT_SECONDS=10

# SMTP (Resend: smtp.resend.com:465, username "resend", password = API key).
# Use MAIL_DRIVER=smtp in production; never commit real credentials.
MAIL_SMTP_HOST=smtp.resend.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USERNAME=resend
MAIL_SMTP_PASSWORD=
MAIL_SMTP_ENCRYPTION=ssl
# Firebase phone-auth (SMS OTP) - placeholders only, real values in .env/.env.production.local.
# The web API key is a public client identifier; restrict it by HTTP referrer in Google Cloud.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_SMS_ENABLED=false